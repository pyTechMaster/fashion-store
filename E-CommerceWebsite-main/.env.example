PORT=3000
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
# Set true only for local UI testing without Razorpay credentials.
DEMO_PAYMENT=false
# Admin dashboard (admin.html) password. Pick a long random value.
ADMIN_KEY=change_this_admin_key

# Push notifications: generate your own keys with  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Email for password-reset codes (optional; without it, reset codes show in the admin dashboard)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BRANDON <your_email@gmail.com>

# Where data (orders, customers, stock...) is stored. Leave empty to use the server-data folder.
# When you host the site, point this to a PERSISTENT disk, e.g. DATA_DIR=/var/data/shoplane
DATA_DIR=
# Daily backup e-mail goes here (default: SMTP_USER). Needs SMTP_USER/SMTP_PASS above.
BACKUP_EMAIL=

# ---- Optional extras (leave empty to keep a feature off) ----
# Google sign-in: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web). Add your site URL under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Google Analytics 4 Measurement ID, looks like G-XXXXXXXXXX (Analytics > Admin > Data streams)
GA_MEASUREMENT_ID=
# Automatic WhatsApp messages (Meta WhatsApp Cloud API). Needs an approved template with ONE body variable {{1}}.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=en
# Automatic SMS (Fast2SMS). Paste your API key.
FAST2SMS_KEY=
